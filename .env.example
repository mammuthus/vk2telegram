# Required by the legacy aiogram process, including DRY_RUN mode.
BOT_TOKEN=

# Use a client ID from an official VK application you control. Avoid the legacy default.
VK_APP_ID=
# VK user access token with messages and offline permissions.
VK_ACCESS_TOKEN=
# A VK group-chat peer ID: 2000000000 + chat_id.
VK_TARGET_PEER_ID=

# Private Telegram channel ID, normally a negative value beginning with -100.
TELEGRAM_TARGET_CHAT_ID=
# Synthetic local owner for the direct relay mapping; leave as 0 unless needed.
RELAY_OWNER_TG_USER_ID=0
# Comma-separated numeric VK sender IDs to skip; leave empty to disable blocklist.
VK_BLOCKED_SENDER_IDS=

# true: listen only, log target VK events, and never call the Telegram API.
DRY_RUN=true

# Host address for the published Prometheus metrics port.
METRICS_BIND_ADDRESS=127.0.0.1

# Docker Compose local PostgreSQL settings.
POSTGRES_DB=tgvkbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_HOST=db
DATABASE_PORT=5432
# Leave empty to use the individual PostgreSQL settings above.
DATABASE_URL=